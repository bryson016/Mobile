# Copy to .env and update with your PC's LAN IP
# Find IP: Windows -> ipconfig (IPv4), Mac/Linux -> ifconfig / ip addr
# Phone + PC must be on SAME Wi-Fi. Backend must run on port 5000.
EXPO_PUBLIC_API_URL=http://192.168.0.108:5000/api

# For Android emulator use:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# For iOS simulator / web use:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api